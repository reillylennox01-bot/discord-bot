{
  "name": "discord-bot",
  "version": "0.1.0",
  "description": "Discord bot starter project",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "sh -c \"node src/index.js & node src/web.js\"",
    "dev": "nodemon src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "pm2-start": "pm2 start ecosystem.config.cjs",
    "pm2-save": "pm2 save",
    "pm2-stop": "pm2 stop discord-bot",
    "pm2-restart": "pm2 restart discord-bot",
    "pm2-status": "pm2 status"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/rest": "^1.5.0",
    "discord-api-types": "^0.37.41",
    "discord.js": "^14.13.0",
    "dotenv": "^16.4.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
